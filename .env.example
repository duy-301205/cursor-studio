# Copy to .env for local Docker Compose development. Keep .env out of Git.
MYSQL_DATABASE=cursor_studio
MYSQL_USER=cursor_app

# Replace these local-only placeholders before first startup.
MYSQL_PASSWORD=CHANGE_ME_LOCAL
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT

# Origin of the frontend Vite server running on the host.
CORS_ORIGINS=http://localhost:5173
AUTO_SEED=true
